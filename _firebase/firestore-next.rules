rules_version = '2';

// Rules for the rewritten games. PUBLISH THESE ALONGSIDE THE EXISTING ONES —
// paste the `dualityRooms` block into the rules you already have, keeping the
// `sharedData`, `games` and `EscherChessGames` blocks as they are. This adds a
// collection rather than changing any existing one, so the V3.1 game keeps
// working throughout.
//
// Requires Anonymous Authentication to be enabled.
//
// Two things make real enforcement possible here, where the interim rules could
// only check shapes:
//
//   * Whose turn it is is derivable from the log — seat 0 moves first, so the
//     seat on move is `moves.size() % 2`. A rule cannot replay a board, but it
//     can count, so it can refuse a move from anybody but the player on move.
//   * Staleness is judged against request.time, not against anything the
//     client says, so a tab cannot hold its seat open while disconnected. The
//     seat times themselves are client millis: they sit inside an array, and
//     Firestore forbids serverTimestamp() there, so the best available is to
//     bound them against the server clock.
//
// On creation: rooms are made lazily by whoever arrives first, but only under
// one of the twenty names below and only as an empty game. The number of
// documents this project can ever hold is therefore fixed, which is the
// property that matters — on the free plan an unbounded document count is a
// quota exhausted and the games offline for the day. Keep this list in step
// with assets/games/net/rooms.js.

service cloud.firestore {
  match /databases/{database}/documents {

    match /dualityRooms/{roomId} {

      function signedIn() {
        return request.auth != null && request.auth.uid is string;
      }

      function known() {
        return roomId in [
          'RedPuck', 'BlueGoal', 'GreenField', 'GoldRink', 'SilverNet',
          'BronzeStripes', 'PurpleSkates', 'OrangeWhistle', 'WhitePuck', 'BlackGoal',
          'AmberField', 'CoralRink', 'IvoryNet', 'JadeStripes', 'OnyxSkates',
          'PearlWhistle', 'RustPuck', 'SableGoal', 'TealField', 'UmberRink'
        ];
      }

      function before() { return resource.data; }
      function after() { return request.resource.data; }

      /**
       * Seat times are integer milliseconds from the client, not Firestore
       * timestamps.
       *
       * They live inside `seats`, which is an array, and Firestore forbids
       * serverTimestamp() sentinels inside arrays — so the server cannot stamp
       * them. Comparisons therefore go through request.time.toMillis(), and a
       * beat is only bounded in the future: a value in the past is harmless and
       * self-correcting, whereas one far ahead would park a seat indefinitely.
       */
      function nowMs() { return request.time.toMillis(); }

      function seatShapeOk(i) {
        return after().seats[i].keys().hasOnly(['uid', 'claimedAt', 'lastSeen', 'lastActive']);
      }

      function plausibleBeat(i) {
        return after().seats[i].lastSeen is int
          && after().seats[i].lastSeen <= nowMs() + 600000;
      }

      // Only seats and moves ever change; everything else is fixed at creation.
      function shapeIsIntact() {
        return after().keys().hasOnly(['version', 'name', 'game', 'seats', 'moves'])
          && after().version == before().version
          && after().name == before().name
          && after().game == before().game
          && after().seats.size() == 2
          && seatShapeOk(0) && seatShapeOk(1)
          && after().moves.size() <= 500;
      }

      // Vacant: nobody holds it, or its holder has been silent for five minutes.
      function seatVacant(i) {
        return before().seats[i].uid == null
          || before().seats[i].lastSeen == null
          || nowMs() > before().seats[i].lastSeen + 300000;
      }

      function seatMine(i) {
        return before().seats[i].uid == request.auth.uid;
      }

      // You may only write your own uid into a seat, and only when it is vacant
      // or already yours.
      function seatWriteOk(i) {
        return after().seats[i] == before().seats[i]
          || (
            after().seats[i].uid == request.auth.uid
            && plausibleBeat(i)
            && (seatVacant(i) || seatMine(i))
          )
          || (seatMine(i) && after().seats[i].uid == null); // releasing your own
      }

      function seatsOk() {
        return seatWriteOk(0) && seatWriteOk(1);
      }

      // Claiming, beating or releasing. The move log must not move.
      function isSeatOperation() {
        return after().moves == before().moves && seatsOk();
      }

      // Exactly one move appended, by the seat whose turn it is.
      function isMoveAppend() {
        return after().moves.size() == before().moves.size() + 1
          && after().moves[0:before().moves.size()] == before().moves
          && before().seats[before().moves.size() % 2].uid == request.auth.uid
          && seatsOk();
      }

      // Starting again in the same room, keeping both seats.
      function isReset() {
        return after().moves.size() == 0
          && before().moves.size() > 0
          && seatsOk();
      }

      /**
       * A seat in a brand-new room: either empty, or taken by whoever is
       * creating it. Arriving first and sitting down is one action, so
       * demanding that the room be born empty would refuse every real create —
       * there is no moment between the two for a second write to happen in.
       */
      function freshSeat(i) {
        return after().seats[i].uid == null
          || (after().seats[i].uid == request.auth.uid && plausibleBeat(i));
      }

      function isFreshRoom() {
        return after().keys().hasOnly(['version', 'name', 'game', 'seats', 'moves'])
          && after().name == roomId
          && after().version == 1
          && after().moves.size() == 0
          && after().seats.size() == 2
          && seatShapeOk(0) && seatShapeOk(1)
          && freshSeat(0) && freshSeat(1);
      }

      allow read: if signedIn() && known();
      allow create: if signedIn() && known() && isFreshRoom();
      allow delete: if false;
      allow update: if signedIn()
        && known()
        && shapeIsIntact()
        && (isSeatOperation() || isMoveAppend() || isReset());
    }
  }
}
