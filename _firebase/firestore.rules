rules_version = '2';

// Firestore Security Rules for the `soccerhockeyduality` project, which serves
// Soccer Hockey and Escher Chess. This is the whole published file: paste it
// over what is in the console.
//
// Three collections, and no others. The V3.1 and V1.2 games had three more —
// `games`, `EscherChessGames` and `sharedData` — which were dropped when those
// versions were archived; delete those collections in the console too, since
// nothing can reach them now.
//
// Requires Anonymous Authentication, and "Enable create (sign-up)" under
// Authentication -> Settings -> User actions.
//
// Deliberately plain. Rules run on Google's servers and cannot be tested from
// this repository, so everything here sticks to operations whose behaviour is
// unambiguous: equality between primitives, .size(), .keys().hasOnly(), list
// indexing, and arithmetic. List slicing and whole-map equality are avoided —
// an earlier version used both and refused every legitimate move, which is not
// a failure you can see until two people are sat in front of it.
//
// The project is on the free Spark plan, where exhausting the daily quota
// disables Firestore rather than costing anything. Rules cannot rate-limit;
// App Check is the defence. See README.md in this directory.

service cloud.firestore {
  match /databases/{database}/documents {

    // Soccer Hockey: one room per game in progress.
    match /dualityRooms/{roomId} {

      function signedIn() {
        return request.auth != null && request.auth.uid is string;
      }

      // The pool is fixed, so the number of documents this project can ever
      // hold is fixed too. Keep in step with assets/games/net/rooms.js.
      function known() {
        return roomId in [
          'RedPuck', 'BlueGoal', 'GreenField', 'GoldRink', 'SilverNet',
          'BronzeStripes', 'PurpleSkates', 'OrangeWhistle', 'WhitePuck', 'BlackGoal',
          'AmberField', 'CoralRink', 'IvoryNet', 'JadeStripes', 'OnyxSkates',
          'PearlWhistle', 'RustPuck', 'SableGoal', 'TealField', 'UmberRink'
        ];
      }

      function before() { return resource.data; }
      function after() { return request.resource.data; }

      // Seat times are integer milliseconds from the client. They sit inside an
      // array and Firestore forbids serverTimestamp() there, so the server
      // cannot stamp them; instead they are bounded against the server clock.
      // Only the future is bounded — a stale value is harmless and corrects
      // itself, whereas one far ahead would park a seat indefinitely.
      function nowMs() { return request.time.toMillis(); }

      function seatShapeOk(i) {
        return after().seats[i].keys().hasOnly(['uid', 'claimedAt', 'lastSeen', 'lastActive']);
      }

      function plausibleBeat(i) {
        return after().seats[i].lastSeen is int
          && after().seats[i].lastSeen <= nowMs() + 600000;
      }

      // Only seats and moves ever change; the rest is fixed at creation.
      function shapeIsIntact() {
        return after().keys().hasOnly(['version', 'name', 'game', 'seats', 'moves'])
          && after().version == before().version
          && after().name == before().name
          && after().game == before().game
          && after().seats.size() == 2
          && seatShapeOk(0) && seatShapeOk(1)
          && after().moves.size() <= 500;
      }

      // Vacant: nobody holds it, or its holder has been silent for five minutes.
      function seatVacant(i) {
        return before().seats[i].uid == null
          || before().seats[i].lastSeen == null
          || nowMs() > before().seats[i].lastSeen + 300000;
      }

      function seatMine(i) {
        return before().seats[i].uid == request.auth.uid;
      }

      // Who holds a seat may only change in your favour, and only from a seat
      // that is vacant or already yours. Comparing the uid alone rather than
      // the whole seat map keeps this to primitive equality, and still leaves
      // a heartbeat free to update its own timestamps.
      function seatWriteOk(i) {
        return after().seats[i].uid == before().seats[i].uid
          || (
            after().seats[i].uid == request.auth.uid
            && plausibleBeat(i)
            && (seatVacant(i) || seatMine(i))
          )
          || (seatMine(i) && after().seats[i].uid == null); // releasing your own
      }

      function seatsUnchanged() {
        return after().seats[0].uid == before().seats[0].uid
          && after().seats[1].uid == before().seats[1].uid;
      }

      // Claiming, beating or releasing. The log does not move.
      function isSeatOperation() {
        return after().moves.size() == before().moves.size()
          && seatWriteOk(0) && seatWriteOk(1);
      }

      // One move appended, by the seat whose turn it is. Seat 0 opens, so the
      // seat on move is the parity of the log length — a rule cannot replay a
      // board, but it can count.
      function isMoveAppend() {
        return after().moves.size() == before().moves.size() + 1
          && before().seats[before().moves.size() % 2].uid == request.auth.uid
          && seatsUnchanged();
      }

      // Starting again in the same room, keeping both seats.
      function isReset() {
        return after().moves.size() == 0
          && before().moves.size() > 0
          && seatsUnchanged();
      }

      // A new room may be born with one seat taken, provided it is taken by
      // whoever is creating it: arriving first and sitting down is a single
      // write, with no instant between the two for a second write to land in.
      function freshSeat(i) {
        return after().seats[i].uid == null
          || (after().seats[i].uid == request.auth.uid && plausibleBeat(i));
      }

      function isFreshRoom() {
        return after().keys().hasOnly(['version', 'name', 'game', 'seats', 'moves'])
          && after().name == roomId
          && after().version == 1
          && after().moves.size() == 0
          && after().seats.size() == 2
          && seatShapeOk(0) && seatShapeOk(1)
          && freshSeat(0) && freshSeat(1);
      }

      allow read: if signedIn() && known();
      allow create: if signedIn() && known() && isFreshRoom();
      allow delete: if false;
      allow update: if signedIn()
        && known()
        && shapeIsIntact()
        && (isSeatOperation() || isMoveAppend() || isReset());
    }

    // ---------------------------------------------------------------------
    // The sandbox. Same twenty room names, its own documents.
    //
    // A deliberately looser contract than the game above: once the reveal has
    // happened there is nothing left to keep from either player, so whoever
    // holds a seat may change anything — the board size, the duality number,
    // which moves exist, where the ball is. What the rules still guarantee is
    // that a passer-by cannot: a seat is required, and it is claimed under the
    // same terms as a game seat.
    //
    // Separate from dualityRooms precisely because the contract is different.
    // A mistake in this block cannot reach a game in progress.
    // ---------------------------------------------------------------------

    match /dualitySandboxes/{roomId} {

      function signedIn() {
        return request.auth != null && request.auth.uid is string;
      }

      // Keep in step with assets/games/net/rooms.js — the same list as above.
      function known() {
        return roomId in [
          'RedPuck', 'BlueGoal', 'GreenField', 'GoldRink', 'SilverNet',
          'BronzeStripes', 'PurpleSkates', 'OrangeWhistle', 'WhitePuck', 'BlackGoal',
          'AmberField', 'CoralRink', 'IvoryNet', 'JadeStripes', 'OnyxSkates',
          'PearlWhistle', 'RustPuck', 'SableGoal', 'TealField', 'UmberRink'
        ];
      }

      function before() { return resource.data; }
      function after() { return request.resource.data; }
      function nowMs() { return request.time.toMillis(); }

      function seatShapeOk(i) {
        return after().seats[i].keys().hasOnly(['uid', 'claimedAt', 'lastSeen', 'lastActive']);
      }

      function plausibleBeat(i) {
        return after().seats[i].lastSeen is int
          && after().seats[i].lastSeen <= nowMs() + 600000;
      }

      // The bounds are the ones the page enforces, restated here because the
      // page is not what protects the database. A board cannot be so large
      // that one document becomes an expensive thing to store or to serve.
      function configOk() {
        return after().config.keys().hasOnly(['width', 'height', 'duality', 'moveSet'])
          && after().config.width is int
          && after().config.width >= 3 && after().config.width <= 19
          && after().config.height is int
          && after().config.height >= 3 && after().config.height <= 21
          && after().config.duality is int
          && after().config.duality >= 0
          && after().config.duality < after().config.width
          && after().config.moveSet.size() <= 200;
      }

      // As close to "the configuration did not move" as primitives get. The
      // move set is compared by length rather than by contents, for the same
      // reason the game's rules count moves rather than replay them: this is
      // not a language in which a list can be walked. Someone signed in who
      // knew a room name could therefore swap one offset for another without
      // sitting down. That is the loosest thing this block permits, and it is
      // a scratchpad either seat can overwrite in a click regardless.
      function configHeld() {
        return after().config.width == before().config.width
          && after().config.height == before().config.height
          && after().config.duality == before().config.duality
          && after().config.moveSet.size() == before().config.moveSet.size();
      }

      function shapeIsIntact() {
        return after().keys().hasOnly(['version', 'name', 'game', 'seats', 'config', 'moves'])
          && after().version == before().version
          && after().name == before().name
          && after().game == before().game
          && after().seats.size() == 2
          && seatShapeOk(0) && seatShapeOk(1)
          && configOk()
          && after().moves.size() <= 500;
      }

      function seatVacant(i) {
        return before().seats[i].uid == null
          || before().seats[i].lastSeen == null
          || nowMs() > before().seats[i].lastSeen + 300000;
      }

      function seatMine(i) {
        return before().seats[i].uid == request.auth.uid;
      }

      function seatWriteOk(i) {
        return after().seats[i].uid == before().seats[i].uid
          || (
            after().seats[i].uid == request.auth.uid
            && plausibleBeat(i)
            && (seatVacant(i) || seatMine(i))
          )
          || (seatMine(i) && after().seats[i].uid == null);
      }

      // Anything that is not a seat change has to come from somebody sitting
      // down. Both chairs are checked because either seat may be the writer.
      function holdsASeat() {
        return seatMine(0) || seatMine(1);
      }

      // Sitting down is the one write allowed from outside a seat, so it must
      // not carry anything else along with it.
      function isSeatOperation() {
        return configHeld() && after().moves.size() == before().moves.size();
      }

      function freshSeat(i) {
        return after().seats[i].uid == null
          || (after().seats[i].uid == request.auth.uid && plausibleBeat(i));
      }

      function isFreshSandbox() {
        return after().keys().hasOnly(['version', 'name', 'game', 'seats', 'config', 'moves'])
          && after().name == roomId
          && after().version == 1
          && after().game == 'sandbox'
          && after().moves.size() == 0
          && after().seats.size() == 2
          && seatShapeOk(0) && seatShapeOk(1)
          && freshSeat(0) && freshSeat(1)
          && after().config.keys().hasOnly(['width', 'height', 'duality', 'moveSet'])
          && after().config.width is int
          && after().config.width >= 3 && after().config.width <= 19
          && after().config.height is int
          && after().config.height >= 3 && after().config.height <= 21
          && after().config.duality is int
          && after().config.moveSet.size() <= 200;
      }

      allow read: if signedIn() && known();
      allow create: if signedIn() && known() && isFreshSandbox();
      allow delete: if false;
      allow update: if signedIn()
        && known()
        && shapeIsIntact()
        && seatWriteOk(0) && seatWriteOk(1)
        && (holdsASeat() || isSeatOperation());
    }

    // ---------------------------------------------------------------------
    // Escher Chess. Its own twenty room names, and its own documents.
    //
    // Structurally the same contract as dualityRooms: seats are claimed and
    // beaten the same way, and a move is one append by the seat whose turn it
    // is, counted rather than understood. What differs is the payload — a chess
    // move is { from, to, promote } rather than a square — and a `board` field
    // naming which of the published boards is in play. Neither is inspected
    // here; a rule that cannot replay a board has no opinion about either.
    //
    // A separate collection rather than a `game` field on the same documents,
    // because a chess log landing in a room a Soccer Hockey game is being
    // played in is not something a counting rule could sort out afterwards.
    // ---------------------------------------------------------------------

    match /escherRooms/{roomId} {

      function signedIn() {
        return request.auth != null && request.auth.uid is string;
      }

      // Escher Chess's own pool — NOT the Soccer Hockey list above. Keep in
      // step with ESCHER_ROOM_NAMES in assets/games/net/rooms.js.
      function known() {
        return roomId in [
          'RelativityRoom', 'MobiusCheck', 'ImpossibleCastle', 'WaterfallWar', 'MysteriousMoves',
          'ParadoxPawn', 'InfiniteKnight', 'MirroredGambit', 'TessellatedTactics', 'RecursiveRook',
          'AscendingBishop', 'BelvedereBoard', 'PenroseStairs', 'MetamorphosisMate', 'DrosteDefence',
          'SkyAndWater', 'CircleLimit', 'DayAndNight', 'ReptileRank', 'CurvedSpace'
        ];
      }

      function before() { return resource.data; }
      function after() { return request.resource.data; }
      function nowMs() { return request.time.toMillis(); }

      function seatShapeOk(i) {
        return after().seats[i].keys().hasOnly(['uid', 'claimedAt', 'lastSeen', 'lastActive']);
      }

      function plausibleBeat(i) {
        return after().seats[i].lastSeen is int
          && after().seats[i].lastSeen <= nowMs() + 600000;
      }

      function knownBoard(id) {
        return id in ['escher-5x10', 'escher-8x8', 'escher-tutorial'];
      }

      function shapeIsIntact() {
        return after().keys().hasOnly(['version', 'name', 'game', 'board', 'seats', 'moves'])
          && after().version == before().version
          && after().name == before().name
          && after().game == before().game
          && knownBoard(after().board)
          && after().seats.size() == 2
          && seatShapeOk(0) && seatShapeOk(1)
          && after().moves.size() <= 500;
      }

      // A move means nothing without the board it was played on, so the board
      // may change at exactly one moment: when the log is emptied and there is
      // nothing left for it to invalidate. That is what lets one room host the
      // five-file game and then the eight-file one.
      function boardHeld() { return after().board == before().board; }

      function seatVacant(i) {
        return before().seats[i].uid == null
          || before().seats[i].lastSeen == null
          || nowMs() > before().seats[i].lastSeen + 300000;
      }

      function seatMine(i) {
        return before().seats[i].uid == request.auth.uid;
      }

      function seatWriteOk(i) {
        return after().seats[i].uid == before().seats[i].uid
          || (
            after().seats[i].uid == request.auth.uid
            && plausibleBeat(i)
            && (seatVacant(i) || seatMine(i))
          )
          || (seatMine(i) && after().seats[i].uid == null);
      }

      function seatsUnchanged() {
        return after().seats[0].uid == before().seats[0].uid
          && after().seats[1].uid == before().seats[1].uid;
      }

      function isSeatOperation() {
        return after().moves.size() == before().moves.size()
          && boardHeld()
          && seatWriteOk(0) && seatWriteOk(1);
      }

      // White opens, so the seat on move is the parity of the log length.
      function isMoveAppend() {
        return after().moves.size() == before().moves.size() + 1
          && before().seats[before().moves.size() % 2].uid == request.auth.uid
          && boardHeld()
          && seatsUnchanged();
      }

      // Starting again, possibly on the other board. `shapeIsIntact` has
      // already checked that the new one is a board this game knows about.
      function isReset() {
        return after().moves.size() == 0
          && before().moves.size() > 0
          && seatsUnchanged();
      }

      // Putting a room that has never been played in onto the other board.
      //
      // A room is created with whichever board its first arrival asked for, and
      // anybody who opens the page and shuts the tab leaves one behind with an
      // empty log. Without this those rooms are pinned to that board for good —
      // there is no game to reset, so no reset to change the board alongside —
      // and since the pool is twenty, a run of them makes one of the two boards
      // unreachable. That is not hypothetical: it is what sent somebody who
      // pressed the 8x8 button to a five-file game.
      //
      // Nothing can be destroyed by it. The log is empty on both sides of the
      // write, the seats do not move, and `shapeIsIntact` has already refused
      // any board this game does not know. It does let somebody signed in who
      // knew a room name change the size of a room they are not sitting in,
      // which is a room with nothing in it.
      function isRebrand() {
        return after().moves.size() == 0
          && before().moves.size() == 0
          && seatsUnchanged();
      }

      function freshSeat(i) {
        return after().seats[i].uid == null
          || (after().seats[i].uid == request.auth.uid && plausibleBeat(i));
      }

      function isFreshRoom() {
        return after().keys().hasOnly(['version', 'name', 'game', 'board', 'seats', 'moves'])
          && after().name == roomId
          && after().version == 1
          && after().game == 'escher-chess'
          && knownBoard(after().board)
          && after().moves.size() == 0
          && after().seats.size() == 2
          && seatShapeOk(0) && seatShapeOk(1)
          && freshSeat(0) && freshSeat(1);
      }

      allow read: if signedIn() && known();
      allow create: if signedIn() && known() && isFreshRoom();
      allow delete: if false;
      allow update: if signedIn()
        && known()
        && shapeIsIntact()
        && (isSeatOperation() || isMoveAppend() || isReset() || isRebrand());
    }

    // No other path is matched, so everything else is denied by default.
  }
}
