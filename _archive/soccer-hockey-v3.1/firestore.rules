// The Firestore Security Rules as they stood in August 2026, recorded here
// because they live in the Firebase console and were not otherwise under
// version control. They govern the `soccerhockeyduality` project, which serves
// BOTH Soccer Hockey and Escher Chess.
//
// Known weaknesses, for the record (see _archive/soccer-hockey-v3.1/README.md):
//   * `allow update: if true` lets anyone overwrite any game document outright.
//   * Nothing validates the shape or size of a write.
//   * `MobiusEuclidGames` additionally allows create and delete by anyone.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /sharedData/{document} {
      allow read: if true;
      allow update: if true;
      allow create, delete: if false;
    }
    match /games/{document} {
      allow read: if true;
      allow update: if true;
      allow create, delete: if false;
    }
    match /EscherChessGames/{document} {
      allow read: if true;
      allow update: if true;
      allow create, delete: if false;
    }
    match /MobiusEuclidGames/{document} {
      allow read: if true;
      allow update: if true;
      allow create, delete: if true;
    }
  }
}
